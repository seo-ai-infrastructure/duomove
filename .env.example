# Generate locally: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Set secrets in Railway service variables, never in this repository.
DUOMOVE_SERVICE_TOKEN=
# Use only authorized device endpoints. Empty targets are valid for HTTP testing.
DUOMOVE_ADB_TARGETS_JSON={}
# Explicitly establish network ADB transport before a diagnostic probe.
DUOMOVE_ADB_CONNECT=false
DUOMOVE_ADB_TIMEOUT_SECONDS=8
# Railway supplies PORT; local default is 8000.
PORT=8000
# No DuoPlus/WiGLE/Supabase credentials are required or read in this phase.
