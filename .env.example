# Server-to-server credential only. Generate your own, never commit it:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
DUOMOVE_INTERNAL_TOKEN=

# Configure aliases -> already connected ADB serials in Railway Variables.
# Empty by default: no device can be probed. Do not use actual values in Git.
DUOMOVE_TARGETS_JSON={}
DUOMOVE_ADB_TIMEOUT_SECONDS=10
DUOMOVE_ADB_EXECUTABLE=adb
PORT=8000

# .env files are NOT automatically loaded. Use Railway Variables or export
# settings into the process environment. This milestone requires no provider keys.
